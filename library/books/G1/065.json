  {
   "n": 7,
   "image": "books/G1/065/p07.jpg",
   "w": 1401,
   "h": 550,
   "text": "Bunny hopped into a hole. She saw a pink monster. Sunny hopped behind a bush. She saw a black and white monster.",
   "textBox": null,
