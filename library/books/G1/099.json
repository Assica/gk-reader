   ]
  },
  {
   "n": 6,
   "image": "books/G1/099/p06.jpg",
   "w": 1400,
   "h": 549,
   "text": "The worker bees sip the nectar f rom the f lowers. Then they carry the nectar home.",
   "textBox": [
    0.0499,
    0.1072,
    0.3609,
    0.2881
   ],
   "wordBoxes": null,
   "audio": [
