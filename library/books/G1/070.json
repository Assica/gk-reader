   "w": 1400,
   "h": 894,
   "text": "I see flowers in the park. The flowers look pretty. I have two eyes. I use my eyes to see.",
   "textBox": null,
   "wordBoxes": null,
   "audio": [
    23.68,
    26.65
   ]
  },
  {
   "n": 5,
   "image": "books/G1/070/p05.jpg",
   "w": 1400,
   "h": 894,
   "text": "I have two ears. I use my ears to hear. I hear a bird in the park. The bird sings a song.",
   "textBox": null,
   "wordBoxes": null,
   "audio": [
    27.7,
    30.93
   ]
  },
  {
   "n": 6,
   "image": "books/G1/070/p06.jpg",
   "w": 1400,
   "h": 894,
   "text": "I have a nose. I use my nose to smell. I smell food in the park. The food smells good.",
